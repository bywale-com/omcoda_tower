{
  "name": "tower",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:api": "node scripts/bundle-vercel-api.mjs",
    "build:vercel": "vite build && npm run build:api",
    "dev": "vite",
    "dev:auth": "tsx --env-file=.env server/auth-service/index.ts",
    "db:migrate": "tsx --env-file=.env scripts/run-migration.ts",
    "db:seed": "tsx --env-file=.env scripts/run-seed.ts",
    "worker": "tsx --env-file=.env server/wire-service/worker.ts",
    "worker:once": "WORKER_ONCE=1 tsx --env-file=.env server/wire-service/worker.ts",
    "verify:machine": "tsx --env-file=.env scripts/verify-machine-e2e.ts",
    "verify:worker": "tsx --env-file=.env scripts/verify-worker-actuation.ts",
    "verify:continuous-worker": "tsx --env-file=.env scripts/verify-continuous-worker.ts",
    "verify:session-firm": "tsx --env-file=.env scripts/verify-session-firm.ts",
    "verify:firm-binding": "tsx --env-file=.env scripts/verify-firm-binding.ts",
    "verify:production-walk": "tsx --env-file=.env scripts/verify-production-walk.ts",
    "verify:boot-env": "tsx --env-file=.env scripts/verify-boot-env.ts",
    "verify:automations": "tsx --env-file=.env scripts/verify-automations-alive.ts",
    "verify:modular": "tsx --env-file=.env scripts/verify-modular-surfaces.ts",
    "verify:ship": "tsx --env-file=.env scripts/verify-ship-spine.ts && tsx --env-file=.env scripts/verify-deny-gates.ts",
    "verify:affordances": "tsx --env-file=.env scripts/verify-affordance-roundtrip.ts",
    "verify:deploy": "npm run verify:ship && npm run verify:session-firm && npm run verify:boot-env && npm run verify:continuous-worker",
    "verify:all-ship": "npm run verify:ship && npm run verify:affordances && npx tsx --env-file=.env scripts/restore-channel-order.ts && VERIFY_LIVE_SEND=1 npm run verify:worker && npm run verify:session-firm && npm run verify:boot-env",
    "verify:author-runtime": "tsx --env-file=.env scripts/verify-author-runtime.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hono/node-server": "^1.14.4",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@xyflow/react": "^12.11.0",
    "antd": "^6.5.3",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "hono": "^4.7.10",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "papaparse": "^5.5.4",
    "pg": "^8.14.1",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.17.0",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "resend": "^4.5.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "twilio": "^5.13.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.11",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.1.12",
    "tsx": "^4.19.3",
    "vite": "6.4.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
