{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/auth/[[...path]].ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/wire/[[...path]].ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/ping.ts": {
      "memory": 128,
      "maxDuration": 5
    }
  },
  "crons": [
    {
      "path": "/api/wire/machine/tick",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/wire/:path*",
      "destination": "/api/wire/:path*"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
