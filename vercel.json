{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/auth.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "dist-api/**"
    },
    "api/wire.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "dist-api/**"
    },
    "api/ping.ts": {
      "memory": 128,
      "maxDuration": 5
    }
  },
  "crons": [
    {
      "path": "/api/wire/machine/tick",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/wire",
      "destination": "/api/wire"
    },
    {
      "source": "/wire/:path*",
      "destination": "/api/wire"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/wire/:path*",
      "destination": "/api/wire"
    },
    {
      "source": "/prototype-ant",
      "destination": "/prototype-ant.html"
    },
    {
      "source": "/prototype-ant/:path*",
      "destination": "/prototype-ant.html"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
