{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth/[[...path]].ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
