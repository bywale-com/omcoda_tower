[Unit]
Description=Tower continuous tick worker (attempt-window escalation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tower
EnvironmentFile=/opt/tower/.env
# Continuous — never WORKER_ONCE in production
Environment=WORKER_INTERVAL_MS=60000
Environment=NODE_ENV=production
Environment=DEPLOY_STRICT=1
ExecStart=/usr/bin/npx tsx --env-file=/opt/tower/.env server/wire-service/worker.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
