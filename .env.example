# Supabase Postgres
#
# Windows / IPv4-only: use **Session pooler** (NOT direct db.*.supabase.co — IPv6 only).
# Dashboard → Project Settings → Database → Connection string → Session mode
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
#
# Direct connection (IPv6 — works on some networks only):
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
#
# Vercel prod: Transaction pooler (port 6543, ?pgbouncer=true)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Password with $ or other special chars must be URL-encoded ($ → %24)

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Tower <onboarding@yourdomain.com>

# Auth Service (local dev only)
AUTH_SERVICE_PORT=3001

# Dev/demo only — skip product AuthGate + Register password gate.
# Defaults ON in Vite DEV (and vite.config define). Set false to exercise real OTP Login.
# Never set true in Vercel Production.
VITE_AUTH_DISABLED=true

# CORS — comma-separated origins (required in production)
# ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:5173

# Register gate (server-only — never VITE_*)
REGISTER_ENABLED=true
REGISTER_PASSWORD=change-me-in-dev

# Client build flags (not secrets)
# Expose /register in the SPA. Defaults ON in Vite DEV / vite define.
# Set false (or omit in a production build) when Register must stay dark.
VITE_REGISTER_ENABLED=true

# Do NOT set VITE_AUTH_BASE_URL in production (same-origin /auth)
