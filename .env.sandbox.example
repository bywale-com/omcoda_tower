# =============================================================================
# Sandbox / agent cutover env — EXAMPLE ONLY (safe to commit)
# =============================================================================
# How to use:
#   1. Copy this file locally as `.env.sandbox` (or `.env`) — DO NOT commit the copy.
#   2. Replace every FILL_ME with real values from Supabase / Resend / Twilio / Vercel.
#   3. Upload the filled file into the Cursor agent chat (not into git).
#   4. Agent copies values into the sandbox gitignored `.env` and runs migrate / webhook / tests.
#
# Never commit real secrets. This file must stay placeholders only.
# =============================================================================

# --- REQUIRED for migrate + Postgres CT stores ---
# Supabase → Project Settings → Database → Connection string
# Prefer Session pooler (port 5432) for the agent sandbox.
DATABASE_URL=FILL_ME_postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- REQUIRED for real email (CEM + domain verify + webhook setup) ---
RESEND_API_KEY=FILL_ME_re_xxxxxxxx
RESEND_FROM_EMAIL=Tower <send@mail.try-tower.com>
MAIL_ROOT_DOMAIN=mail.try-tower.com

# Optional but recommended — Resend webhook signing (Svix). Leave blank if unset.
RESEND_WEBHOOK_SECRET=FILL_ME_OR_LEAVE_BLANK_whsec_xxxxxxxx

# Public URL of the deployed app (for creating the Resend webhook endpoint).
# Example: https://omcoda-tower.vercel.app
PUBLIC_APP_URL=FILL_ME_https://omcoda-tower.vercel.app

# --- REQUIRED for real SMS test (Canadian Twilio number) ---
TWILIO_ACCOUNT_SID=FILL_ME_ACxxxxxxxx
TWILIO_AUTH_TOKEN=FILL_ME_xxxxxxxx
TWILIO_FROM_NUMBER=FILL_ME_+1xxxxxxxxxx

# --- Optional: one real test recipient (agent will send a probe here) ---
# Use an inbox / phone you control.
TEST_EMAIL_TO=FILL_ME_you@example.com
TEST_SMS_TO=FILL_ME_+1xxxxxxxxxx

# --- Client / local flags (usually leave as-is for cutover) ---
VITE_WIRE_REAL=true
VITE_AUTH_DISABLED=true
VITE_REGISTER_ENABLED=true
AUTH_SERVICE_PORT=3001
REGISTER_ENABLED=true
REGISTER_PASSWORD=change-me-in-dev
