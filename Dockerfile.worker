# Continuous tick worker — deploy target (no WORKER_ONCE).
# Interval ≤ attempt-window granularity (default 60s).
FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server ./server
COPY scripts ./scripts

ENV NODE_ENV=production
ENV WORKER_INTERVAL_MS=60000

# Continuous process — do not set WORKER_ONCE in the deploy target.
CMD ["npx", "tsx", "server/wire-service/worker.ts"]
